rules_version = '2';
// Regras de segurança do Firestore. Visão geral e motivos de cada regra:
// docs/ARQUITETURA.md (Arquitetura de Segurança). Testes: tests/rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções de apoio
    function signedIn() { return request.auth != null; }
    // Conta de verdade (Google, Apple ou e-mail). A conta anônima do primeiro
    // uso só navega sozinha: não entra em grupos nem publica nada.
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function isLat(v) { return v is number && v >= -90 && v <= 90; }
    function isLng(v) { return v is number && v >= -180 && v <= 180; }
    // Campo opcional: se veio, precisa ser válido.
    function optStr(d, k, max) { return !(k in d) || str(d[k], max); }
    function optNum(d, k) { return !(k in d) || d[k] is number; }

    function isMember(code) {
      return exists(/databases/$(database)/documents/expeditions/$(code)/members/$(request.auth.uid));
    }

    // Foto do veículo: só do Storage do app, na pasta do próprio usuário
    // (lá o Storage limita a 2 MB e a JPEG/PNG/WebP).
    function validPhoto(url) {
      return url == null || (url is string && url.size() <= 400 && url.matches(
        '^https://firebasestorage[.]googleapis[.]com/v0/b/helpaitechcomboio[.]firebasestorage[.]app/o/bikes%2F'
        + request.auth.uid + '%2F[^/?]+([?].*)?$'));
    }
    function validBike(b) {
      return b is map
        && b.keys().hasOnly(['brand', 'model', 'style', 'color', 'photoUrl', 'axles', 'trailerAxles'])
        && optStr(b, 'brand', 40) && optStr(b, 'model', 60) && optStr(b, 'style', 20)
        && (!('color' in b) || b.color is int)
        // Eixos (ônibus/caminhão) e reboque: usados no cálculo do pedágio.
        && (!('axles' in b) || (b.axles is int && b.axles >= 2 && b.axles <= 20))
        && (!('trailerAxles' in b) || (b.trailerAxles is int && b.trailerAxles >= 0 && b.trailerAxles <= 2))
        && (!('photoUrl' in b) || validPhoto(b.photoUrl));
    }

    // ---------- Expedições
    match /expeditions/{code} {
      // Quem tem o código consegue abrir a expedição (o código é o convite).
      // Códigos novos têm 8 caracteres (32^8 combinações: inviável adivinhar).
      allow get: if hasAccount();
      allow list: if false;
      allow create: if hasAccount()
        && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'leaderId', 'createdAt', 'plan'])
        && str(request.resource.data.name, 60);
      // Líder: tudo (inclusive capitão e até 3 ferrolhos). Capitão: a rota
      // (recalculada quando ele sai do trajeto) e passar a capitania para
      // outro membro (que deixa de ser ferrolho, se era).
      allow update: if hasAccount() && (
        (resource.data.leaderId == request.auth.uid
          && request.resource.data.leaderId == resource.data.leaderId
          && str(request.resource.data.name, 60)
          && (!('captainId' in request.resource.data) || str(request.resource.data.captainId, 128))
          && (!('sweepers' in request.resource.data)
              || (request.resource.data.sweepers is list
                  && request.resource.data.sweepers.size() <= 3)))
        || (resource.data.get('captainId', '') == request.auth.uid
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['captainId', 'sweepers'])
              && str(request.resource.data.captainId, 128)
              && exists(/databases/$(database)/documents/expeditions/$(code)/members/$(request.resource.data.captainId))
              && request.resource.data.get('sweepers', []) ==
                  resource.data.get('sweepers', []).removeAll([request.resource.data.captainId]))))
      );
      allow delete: if hasAccount() && resource.data.leaderId == request.auth.uid;

      match /members/{uid} {
        function validMember() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'joinedAt', 'bike', 'lat', 'lng', 'speed', 'heading', 'updatedAt'])
            && optStr(d, 'name', 60)
            && (!('lat' in d) || isLat(d.lat)) && (!('lng' in d) || isLng(d.lng))
            && optNum(d, 'speed') && optNum(d, 'heading')
            && (!('bike' in d) || validBike(d.bike));
        }
        allow read: if hasAccount() && isMember(code);
        // Cada piloto só escreve o próprio registro (nome, moto e posição),
        // e só numa expedição que existe.
        allow create: if hasAccount() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/expeditions/$(code))
          && validMember();
        allow update: if hasAccount() && request.auth.uid == uid && validMember();
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Roteiro: todos os membros veem; o líder altera. O capitão só
      // atualiza os trechos (manobras) quando recalcula a rota.
      match /stops/{stopId} {
        allow read: if hasAccount() && isMember(code);
        allow write: if hasAccount()
          && get(/databases/$(database)/documents/expeditions/$(code)).data.leaderId == request.auth.uid;
        allow update: if hasAccount()
          && get(/databases/$(database)/documents/expeditions/$(code)).data.get('captainId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['legDistanceM', 'legDurationS', 'steps']);
      }

      // SOS: o membro aciona em nome próprio; qualquer membro pode marcar
      // como resolvido, mas ninguém altera quem pediu, onde nem quando.
      match /alerts/{alertId} {
        allow read: if hasAccount() && isMember(code);
        allow create: if hasAccount() && isMember(code)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'lat', 'lng', 'resolved', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && str(request.resource.data.name, 60)
          && isLat(request.resource.data.lat) && isLng(request.resource.data.lng)
          && request.resource.data.resolved == false;
        allow update: if hasAccount() && isMember(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt'])
          && request.resource.data.resolved == true;
        allow delete: if false;
      }

      // Pedidos ao grupo ("Preciso abastecer"...): só os pilotos da
      // expedição veem; cada um envia em nome próprio; apagados sozinhos
      // (TTL em expiresAt, 1 hora).
      match /requests/{reqId} {
        allow read: if hasAccount() && isMember(code);
        allow create: if hasAccount() && isMember(code)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'target', 'lat', 'lng', 'createdAt', 'expiresAt'])
          && request.resource.data.uid == request.auth.uid
          && str(request.resource.data.name, 60)
          && request.resource.data.kind in ['fuel', 'restroom', 'rest', 'problem', 'behind', 'helping']
          && optStr(request.resource.data, 'target', 60)
          && isLat(request.resource.data.lat) && isLng(request.resource.data.lng)
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt < request.time + duration.value(2, 'h');
        // Capitão ou líder confirma ("OK 👍"): só os campos do OK, em nome
        // próprio, uma vez.
        allow update: if hasAccount()
          && (get(/databases/$(database)/documents/expeditions/$(code)).data.get('captainId', '') == request.auth.uid
              || get(/databases/$(database)/documents/expeditions/$(code)).data.leaderId == request.auth.uid)
          && !('ackBy' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackBy', 'ackName', 'ackAt'])
          && request.resource.data.ackBy == request.auth.uid
          && str(request.resource.data.ackName, 60);
        allow delete: if false;
      }
    }

    // ---------- Metadados gerados pelas Cloud Functions (ex.: versão dos radares)
    match /meta/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- Só o servidor: uso diário das funções, códigos de ativação
    // de clube (HelpAITech) e convites de uso único.
    match /usage/{uid} {
      allow read, write: if false;
    }

    // Usuários Gold: cada um só confere o próprio; ninguém grava pelo app.
    // Estatísticas de contribuição (programa Ouro): só o servidor grava;
    // cada pessoa pode ver as próprias.
    match /userStats/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /gold/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Administração UauGo: cada um só confere o próprio; tudo pelas funções.
    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /clubActivations/{code} {
      allow read, write: if false;
    }
    match /clubInvites/{code} {
      allow read, write: if false;
    }

    // ---------- Perfil privado (autorizações, cidade base, token de push)
    // Só o dono lê/escreve. A conta anônima também (aceite dos Termos).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Clubes
    function isClubMember(clubId) {
      return exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }
    // Clube OFICIAL: ativar (administradores, com código de ativação da
    // HelpAITech), entrar (convite de uso único) e mudar administradores só
    // pelo servidor (functions/clubs.js). O app só lê, edita o próprio
    // cadastro e sai; administradores removem membros.
    function isClubAdmin(clubId) {
      let c = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      return 'admins' in c
        ? request.auth.uid in c.admins
        : c.get('presidentId', c.get('createdBy', null)) == request.auth.uid;
    }
    // Administrador precisa perder a função (setClubAdmin) antes de sair ou
    // ser removido: assim a lista de administradores fica sempre certa.
    function isAdminMember() {
      return resource.data.get('role', 'member') in ['admin', 'president'];
    }
    match /clubs/{clubId} {
      allow get: if hasAccount() && isClubMember(clubId);
      allow list, create, update, delete: if false;

      // Membros veem nome, cidade (se autorizada) e moto. Nunca coordenadas.
      match /members/{uid} {
        allow read: if hasAccount() && isClubMember(clubId);
        allow create: if false;
        // Cada um muda só nome, cidade e moto (nunca o papel nem quem convidou).
        allow update: if hasAccount() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'city', 'bike'])
          && optStr(request.resource.data, 'name', 60)
          && optStr(request.resource.data, 'city', 80)
          && optStr(request.resource.data, 'bike', 100);
        // Sair do clube, ou um administrador remover um membro.
        allow delete: if signedIn() && !isAdminMember()
          && (request.auth.uid == uid || isClubAdmin(clubId));
      }
      // Registro de avisos e limite de envios: só as Cloud Functions.
      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // ---------- Alertas públicos (polícia, buraco, perigo...) ----------
    function validExpiry() {
      return request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
    }

    // Usuário Gold: gold/{uid}, gravado só pelo responsável (script/admin).
    // Gold: gold/{uid} (gravado só pelo responsável) ou administrador da
    // plataforma (platformAdmins/{uid}).
    function isGold() {
      return exists(/databases/$(database)/documents/gold/$(request.auth.uid))
        || exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // Tipos que ficam fixos no mapa (lombada, radar fixo, semáforo).
    function permanentTypes() {
      return ['bump', 'fixedRadar', 'signal'];
    }

    // Valor de pedágio informado/confirmado por um piloto (com conta): um
    // relato por pessoa e praça; o servidor (onTollReport) junta os relatos.
    match /tollReports/{plaza}/reports/{uid} {
      function money(v) { return v == null || (v is number && v >= 0 && v < 500); }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if hasAccount() && request.auth.uid == uid
        && plaza.size() <= 40
        && request.resource.data.keys().hasOnly(['car', 'moto', 'at'])
        && money(request.resource.data.get('car', null))
        && money(request.resource.data.get('moto', null))
        && (request.resource.data.get('car', null) != null
            || request.resource.data.get('moto', null) != null)
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // SOS em tempo real: quem tem o link (token aleatório) lê um documento;
    // ninguém lista. Vale por até 3 h e o TTL apaga depois de expiresAt.
    function validLiveSos(d) {
      return str(d.name, 60) && isLat(d.lat) && isLng(d.lng)
        && d.active is bool && d.updatedAt == request.time;
    }
    match /liveSos/{token} {
      allow get: if token.size() == 32;
      allow list: if false;
      allow create: if signedIn() && token.size() == 32
        && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'lat', 'lng', 'active', 'updatedAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && validLiveSos(request.resource.data)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(3, 'h');
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lat', 'lng', 'active', 'updatedAt'])
        && validLiveSos(request.resource.data);
      allow delete: if false;
    }

    match /hazards/{hazardId} {
      function voteRef() {
        return /databases/$(database)/documents/hazards/$(hazardId)/votes/$(request.auth.uid);
      }
      // Um voto por pessoa: o voto (votes/{uid}) é gravado junto com a
      // contagem, no mesmo lote. Se o voto já existia, a contagem é recusada.
      function validVote() {
        let d = request.resource.data;
        let r = resource.data;
        let keys = d.diff(r).affectedKeys();
        return !exists(voteRef()) && existsAfter(voteRef())
          && (
            // "Ainda está lá": +1 confirmação e renova o prazo (não vale o autor).
            // Lombada/radar fixo/semáforo na 3ª confirmação fica fixo; o que já
            // é fixo só conta o voto (sem mexer no prazo).
            (getAfter(voteRef()).data.up == true
              && r.createdBy != request.auth.uid
              && keys.hasOnly(['confirmations', 'expiresAt', 'lastConfirmedAt', 'permanent'])
              && d.confirmations == r.confirmations + 1
              && (
                (!('expiresAt' in keys) && !('permanent' in keys)
                  && r.get('permanent', false) == true)
                || (!('permanent' in keys) && r.get('permanent', false) != true
                  && validExpiry())
                || ('permanent' in keys && d.permanent == true
                  && r.type in permanentTypes() && d.confirmations >= 3
                  && d.expiresAt is timestamp && d.expiresAt > request.time)
              ))
            ||
            // "Não está mais": +1 descarte; some do mapa (prazo = agora) com 2
            // descartes, com mais descartes que confirmações, ou pelo autor.
            (getAfter(voteRef()).data.up == false
              && keys.hasOnly(['dismissals', 'expiresAt'])
              && d.dismissals == r.dismissals + 1
              && (!('expiresAt' in keys)
                  || (d.expiresAt == request.time
                      && (r.createdBy == request.auth.uid
                          || (r.get('permanent', false) == true
                              ? d.dismissals >= (r.get('gold', false) == true ? 5 : 3)
                              : (d.dismissals >= 2 || d.dismissals > r.confirmations))))))
          );
      }

      // Ler: todos (inclusive a conta anônima, que navega sozinha).
      allow read: if signedIn();
      allow create: if hasAccount()
        && request.resource.data.keys().hasOnly(['type', 'lat', 'lng', 'cell', 'createdBy', 'createdAt', 'expiresAt', 'confirmations', 'dismissals', 'permanent', 'gold', 'hd'])
        // Sentido de quem marcou (graus), para avisar só quem vai no mesmo sentido.
        && (!('hd' in request.resource.data)
            || (request.resource.data.hd is number
                && request.resource.data.hd >= 0 && request.resource.data.hd < 360))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['police','radar','pothole','bump','danger','oil','animal','accident','fog','kite','risk','fixedRadar','signal','stoppedVehicle']
        && isLat(request.resource.data.lat)
        && isLng(request.resource.data.lng)
        && str(request.resource.data.cell, 20)
        && request.resource.data.confirmations == 1
        && request.resource.data.dismissals == 0
        && (
          // Normal: com prazo.
          (request.resource.data.get('permanent', false) == false
            && request.resource.data.get('gold', false) == false
            && validExpiry())
          // Usuário Gold marcando tipo permanente: já nasce fixo.
          || (request.resource.data.permanent == true
            && request.resource.data.gold == true
            && isGold()
            && request.resource.data.type in permanentTypes()
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time)
        );
      allow update: if hasAccount() && validVote();
      allow delete: if false;

      // Votos: cada um vê só o próprio; não muda nem apaga (o TTL apaga).
      match /votes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if hasAccount() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['up', 'expiresAt'])
          && request.resource.data.up is bool
          && validExpiry()
          && getAfter(/databases/$(database)/documents/hazards/$(hazardId)).data.confirmations
             + getAfter(/databases/$(database)/documents/hazards/$(hazardId)).data.dismissals
             == get(/databases/$(database)/documents/hazards/$(hazardId)).data.confirmations
             + get(/databases/$(database)/documents/hazards/$(hazardId)).data.dismissals + 1;
        allow update, delete: if false;
      }
    }
  }
}
