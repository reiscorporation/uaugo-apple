# ============================================================
#  Configuração do Comboio
#  1. Copie este arquivo para "config.env" (o configurar.ps1 faz isso)
#  2. Preencha os valores. As chaves do Maps podem ser criadas
#     automaticamente pelo scripts\preparar-nuvem.ps1
# ============================================================

# Identificador da empresa, ao contrário (ex.: br.com.suaempresa).
# O app fica como <ORG>.comboio. NÃO mude depois de publicar.
ORG=com.seunome

# ID do projeto no Firebase (aparece em Configurações do projeto)
FIREBASE_PROJECT_ID=

# Chaves do Google Maps
ANDROID_MAPS_KEY=
IOS_MAPS_KEY=
# (A chave de rotas e lugares fica no servidor: functions/.env, MAPS_SERVER_KEY)
